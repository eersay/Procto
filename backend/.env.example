NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://procto_user:changeme@localhost:5432/procto_dev

# JWT — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Question Generation — free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google OAuth (optional — email/password login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

CORS_ORIGINS=http://localhost:5173
